  type: ClusterIP

Real Production Example:

helm upgrade --install payment-app ./chart \
--namespace prod \
--set image.repository=acr.azurecr.io/payment-app \
--set image.tag=${BUILD_NUMBER} \
--set replicaCount=4 \
--set autoscaling.enabled=true

pipeline {
    agent any

    environment {
        IMAGE_NAME = "myapp"
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Prepare Values') {
            steps {
                sh '''
                sed -i "s/IMAGE_TAG/${TAG}/g" helm/values-template.yaml
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                helm upgrade --install myapp ./helm \
                -f helm/values-template.yaml
                '''
            }
        }
    }
}
